# PRODUCTION secrets for deploy/docker-compose.prod.yml.
# On the server:  cp deploy/.env.example deploy/.env   then fill in and  chmod 600 deploy/.env
# Never commit deploy/.env (it is git-ignored).
#
# Generate random secrets on the server with:  openssl rand -base64 32

# --- Site ---------------------------------------------------------------------------
# Domain pointing at this server (DNS A record), e.g. folio.example.com or myname.duckdns.org
DOMAIN=
# Let's Encrypt account e-mail (expiry notices only)
ACME_EMAIL=

# --- Database / cache (internal only) --------------------------------------------------
POSTGRES_DB=hotel_db
POSTGRES_USER=hotel_user
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- Auth ----------------------------------------------------------------------------
# Base64, >= 32 bytes. Must NOT be the dev key from docker-compose.yml (the app refuses).
JWT_SECRET=

# --- E-mail (sign-in codes, booking/payment notifications) ----------------------------
# Default: SMTP via Gmail - free, ~500 mails/day. Needs a Google account with 2-Step
# Verification and an APP PASSWORD (https://myaccount.google.com/apppasswords), not your
# normal password. See deploy/README.md, section 5.
MAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# your full Gmail address
SMTP_USERNAME=
# the 16-character app password (spaces may be removed)
SMTP_PASSWORD=
# Sender shown to users - with Gmail it must be the same address, e.g. Folio <you@gmail.com>
MAIL_FROM=
# Alternative: MAIL_PROVIDER=sendgrid + SENDGRID_API_KEY=SG... (SendGrid has no free plan any more)
SENDGRID_API_KEY=

# --- Payments: Stripe (TEST mode keys for a portfolio demo) ---------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From the webhook endpoint https://<DOMAIN>/api/payments/webhook in the Stripe Dashboard
STRIPE_WEBHOOK_SECRET=

# --- Google sign-in -----------------------------------------------------------------
# OAuth 2.0 Web client ID; Authorized JavaScript origin must be https://<DOMAIN>
GOOGLE_CLIENT_ID=

# --- Demo data ------------------------------------------------------------------------
# Default: schema + demo hotel catalogue (inserted only into an empty database).
# For a real launch without demo hotels use:  classpath:db/migration
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed
