POSTGRES_DB=hotel_db
POSTGRES_USER=hotel_user
POSTGRES_PASSWORD=

# Base64, must decode to at least 256 bits (32 bytes) — HS256 (see JwtService) rejects
# anything shorter with a WeakKeyException. Generate one with:
#   openssl rand -base64 32
# Rotating it invalidates every outstanding access/refresh token and OTP session, so
# treat it as a real secret (never commit it) and only rotate deliberately, e.g. on
# suspected leak.
JWT_SECRET=

# SendGrid (sendgrid.com) API key — used to send the 6-digit sign-in code and other
# transactional emails over HTTPS. Get a key at
# https://app.sendgrid.com/settings/api_keys (needs "Mail Send" permission).
SENDGRID_API_KEY=
# Must be a sender verified in SendGrid — Settings -> Sender Authentication ->
# Verify a Single Sender (no domain required). Format: "Name <email@example.com>" or
# just "email@example.com".
MAIL_FROM=

GOOGLE_CLIENT_ID=

# Stripe test-mode secret key (dashboard.stripe.com, Test mode -> Developers -> API keys).
STRIPE_SECRET_KEY=

# Comma-separated list of origins allowed to call the API from a browser. Defaults to
# the local Vite dev server ports if unset — only needed when the frontend is served
# from somewhere else (a Cloudflare Tunnel, a deployed domain, etc.).
# In production (SPRING_PROFILES_ACTIVE=prod) this has no default and MUST be set to
# the real frontend origin(s) (e.g. https://your-app.example.com) — see
# application-prod.yml. Never include localhost in a production value.
CORS_ALLOWED_ORIGINS=
